# 环境变量配置示例
# 复制为 .env 后填写实际值；.env 已被 Git 忽略。
# 密码和密钥请使用密码管理器或 openssl rand -base64 48 生成。

# MySQL 配置
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=online_course
MYSQL_USER=course_user
MYSQL_PASSWORD=

# Redis 配置（未启用认证时可留空）
REDIS_PASSWORD=

# 应用安全配置
JWT_SECRET=
APP_CRYPTO_SECRET=
AUTH_COOKIE_SECURE=true
SECURITY_ALERT_WEBHOOK=
MFA_ISSUER=OnlineCoursePlatform
PAYMENT_RECONCILE_ENABLED=true
PAYMENT_RECONCILE_CRON=0 15 1 * * ?
COURSE_SECURITY_ALLOWED_ORIGINS=https://course.example.com

# Cloudflare Turnstile（生产必须使用 Dashboard 创建的真实密钥）
TURNSTILE_ENABLED=true
TURNSTILE_ALWAYS_REQUIRED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_CLOSED=true
LOGIN_PROTECTION_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=course.example.com

# API 文档开关（生产环境建议关闭）
API_DOC_ENABLED=false

# Dynamic API Providers authorize their own exact HTTPS origin after SSRF validation.
# Insecure HTTP and non-default ports remain explicit deployment-level exceptions.
OUTBOUND_PROVIDER_HTTP_ALLOWED_HOSTS=
OUTBOUND_PROVIDER_ALLOWED_PORTS=
# Security webhooks use a fixed exact-host allowlist (comma-separated, no URLs/wildcards).
OUTBOUND_ALERT_ALLOWED_HOSTS=
OUTBOUND_ALERT_HTTP_ALLOWED_HOSTS=
# Use cloudflare-doh on Fake-IP networks; never relax private-address checks.
OUTBOUND_DNS_MODE=system

# Optional, read-only checks for active providers; never auto-enable or place orders.
PROVIDER_HEALTH_ENABLED=false
PROVIDER_HEALTH_INTERVAL_MILLIS=1800000
