# ========================================
# Vue 前端 .gitignore
# ========================================

# ==================== 依赖 ====================
node_modules/
jspm_packages/

# ==================== 构建输出 ====================
dist/
dist-ssr/
build/
.output/
.nuxt/
.next/

# ==================== 日志 ====================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==================== 环境变量 ====================
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# ==================== 测试覆盖率 ====================
coverage/
*.lcov
.nyc_output/

# ==================== IDE & 编辑器 ====================
# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# Sublime Text
*.sublime-workspace
*.sublime-project

# WebStorm
.webstorm/

# Eclipse
.project
.classpath
.settings/

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# ==================== 操作系统 ====================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ==================== 临时文件 ====================
*.tmp
*.temp
.cache/
.temp/
tmp/

# ==================== Vite ====================
.vite/
vite.config.*.timestamp-*

# ==================== 打包工具 ====================
# Webpack
.webpack/

# Parcel
.parcel-cache/

# Rollup
.rollup.cache/

# ==================== 测试 ====================
# Playwright
/test-results/
/playwright-report/
/playwright/.cache/

# Cypress
cypress/videos/
cypress/screenshots/

# ==================== 其他 ====================
# npm
package-lock.json.backup

# yarn
yarn-error.log

# pnpm
pnpm-lock.yaml.backup

# TypeScript
*.tsbuildinfo

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# AI 工具
.cunzhi-memory/

# Sentry
.sentryclirc

